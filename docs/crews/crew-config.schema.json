{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/marckraw/convergence/master/docs/crews/crew-config.schema.json",
  "title": "Convergence crew configuration v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "crew": {
      "type": "string"
    },
    "emoji": {
      "type": ["string", "null"]
    },
    "color": {
      "type": "string"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deliveriesPerRun": {
          "type": "integer",
          "minimum": 1
        },
        "attentionAfterMinutes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["deliveriesPerRun", "attentionAfterMinutes"]
    },
    "tracker": {
      "description": "The crew's tracker binding (MAR-3211). `project` is the tracker's project id -- the binding itself. `projectName` is shown, never bound. A key is never carried: any other field is refused, and so is any value shaped like a Linear key. The key law covers the whole file: the parser refuses a `lin_api_` string anywhere in it; this schema states the law on the block and on the free-text fields (role cards, wire instructions).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "linear"
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "lin_api_"
          }
        },
        "projectName": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "lin_api_"
          }
        },
        "labelPrefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "lin_api_"
          }
        },
        "wavePrefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "not": {
            "pattern": "lin_api_"
          }
        },
        "statusMap": {
          "type": "object",
          "propertyNames": {
            "minLength": 1,
            "not": {
              "pattern": "lin_api_"
            }
          },
          "additionalProperties": {
            "enum": [
              "backlog",
              "todo",
              "in-progress",
              "in-review",
              "reviewed",
              "done",
              "other"
            ]
          }
        },
        "autoDispatch": {
          "type": "boolean"
        }
      },
      "required": ["kind", "project"]
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "conversation": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": ["string", "null"]
          },
          "effort": {
            "type": ["string", "null"]
          },
          "permissions": {
            "oneOf": [
              {
                "enum": ["ask", "yolo"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "preset": {
                    "const": "custom"
                  },
                  "codex": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "approvalPolicy": {
                        "enum": ["untrusted", "on-request", "never"]
                      },
                      "sandbox": {
                        "enum": [
                          "read-only",
                          "workspace-write",
                          "danger-full-access"
                        ]
                      }
                    },
                    "required": ["approvalPolicy", "sandbox"]
                  },
                  "claudeCode": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "permissionMode": {
                        "enum": [
                          "default",
                          "acceptEdits",
                          "auto",
                          "dontAsk",
                          "plan",
                          "bypassPermissions"
                        ]
                      }
                    },
                    "required": ["permissionMode"]
                  }
                },
                "required": ["preset"]
              }
            ]
          },
          "project": {
            "type": ["string", "null"]
          },
          "lane": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "role": {
            "enum": ["mastermind", "horse", "reviewer", "designer"]
          },
          "kind": {
            "enum": ["resident"]
          },
          "roleCard": {
            "type": "string",
            "not": {
              "pattern": "lin_api_"
            }
          },
          "lanePolicy": {
            "enum": ["main", "own-worktree"]
          },
          "wipLimit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "conversation",
          "provider",
          "model",
          "effort",
          "permissions",
          "project",
          "host"
        ]
      }
    },
    "wires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "spawn": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "provider": {
                        "type": "string"
                      },
                      "model": {
                        "type": ["string", "null"]
                      },
                      "effort": {
                        "type": ["string", "null"]
                      },
                      "project": {
                        "type": ["string", "null"]
                      },
                      "lane": {
                        "type": "string"
                      },
                      "account": {
                        "const": "default"
                      },
                      "host": {
                        "type": "string"
                      },
                      "roleCard": {
                        "type": ["string", "null"],
                        "not": {
                          "type": "string",
                          "pattern": "lin_api_"
                        }
                      },
                      "returnWire": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "instruction": {
                                "type": "string",
                                "not": {
                                  "pattern": "lin_api_"
                                }
                              }
                            },
                            "required": ["instruction"]
                          }
                        ]
                      },
                      "workAddress": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "mode": {
                                "const": "project"
                              },
                              "projectId": {
                                "type": "string"
                              },
                              "workingDirectory": {
                                "type": "string"
                              },
                              "label": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "mode",
                              "projectId",
                              "workingDirectory",
                              "label"
                            ]
                          },
                          {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "mode": {
                                "const": "repository"
                              },
                              "repository": {
                                "type": "string"
                              },
                              "branchName": {
                                "type": ["string", "null"]
                              },
                              "label": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "mode",
                              "repository",
                              "branchName",
                              "label"
                            ]
                          }
                        ]
                      },
                      "member": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "provider",
                      "model",
                      "effort",
                      "project",
                      "account"
                    ]
                  }
                },
                "required": ["spawn"]
              }
            ]
          },
          "when": {
            "type": "string"
          },
          "opener": {
            "oneOf": [
              {
                "enum": ["keep", "clear"]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "first": {
                    "type": "string"
                  }
                },
                "required": ["first"]
              }
            ]
          },
          "instruction": {
            "type": "string",
            "not": {
              "pattern": "lin_api_"
            }
          },
          "armed": {
            "const": false
          }
        },
        "required": ["from", "to", "when", "opener"]
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "required": ["version", "crew", "emoji", "limits", "roles", "wires"]
}
