{
  "files": [
    "apps/convergence/src/**/*.{ts,tsx}",
    "packages/ui/src/**/*.{ts,tsx}"
  ],
  "exclude": [
    "**/*.test.{ts,tsx}",
    "**/*.stories.tsx",
    "**/*.gen.ts",
    "**/generated/**"
  ],
  "classFiles": ["**/*.styles.ts"],
  "attributes": [
    "className",
    "triggerClassName",
    "contentClassName",
    "overlayClassName"
  ],
  "functions": ["cn", "cva"],
  "minUtilities": 4,
  "maxOccurrences": 2,
  "allowlist": []
}
