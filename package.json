{
  "name": "convergence-monorepo",
  "private": true,
  "description": "Monorepo root for Convergence and the packages it shares",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare:icons": "npm run prepare:icons -w convergence",
    "prepare:release-notes": "npm run prepare:release-notes -w convergence",
    "dev": "npm run dev -w convergence",
    "dev:clean": "npm run dev:clean -w convergence",
    "dev:sandbox": "npm run dev:sandbox -w convergence",
    "dev:seed": "npm run dev:seed -w convergence",
    "build": "npm run build -w convergence",
    "build:preview": "npm run build:preview -w convergence",
    "package:mac": "npm run package:mac -w convergence",
    "package:mac:dir": "npm run package:mac:dir -w convergence",
    "package:mac:unsigned": "npm run package:mac:unsigned -w convergence",
    "package:mac:dir:unsigned": "npm run package:mac:dir:unsigned -w convergence",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "changeset:version": "changeset version && npm install --package-lock-only",
    "release:notes": "npm run release:notes -w convergence",
    "test": "npm run test --workspaces --if-present",
    "test:pure": "npm run test:pure --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:electron": "npm run test:electron -w convergence",
    "test:electron:node": "npm run test:electron:node -w convergence",
    "test:watch": "npm run test:watch -w convergence",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "rebuild:electron": "npm run rebuild:electron -w convergence",
    "agent:pre-commit": "npm run format:fix && npm run lint:fix && npm run typecheck",
    "agent:pre-push": "chaperone check --fix && (git diff --quiet --exit-code || (echo \"chaperone produced changes; commit them before pushing.\" && exit 1))"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lefthook": "^2.1.6",
    "prettier": "^3.8.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  }
}
