{
  "extends": [
    "chaperone/pure-functions",
    "chaperone/presentational-components"
  ],
  "rules": {
    "custom": [
      {
        "id": "renderer-preload-access-through-api-files",
        "type": "forbidden-import",
        "severity": "error",
        "files": "apps/*/src/**/*.{ts,tsx}",
        "restrictions": [],
        "checkPatterns": [
          {
            "pattern": "\\bwindow\\.electronAPI\\b",
            "allowedIn": [
              "apps/*/src/**/*.api.ts",
              "apps/*/src/**/*.test.ts",
              "apps/*/src/**/*.test.tsx",
              "apps/*/src/test-setup.ts",
              "apps/*/src/shared/types/electron-api.d.ts"
            ],
            "message": "Renderer preload access must stay behind *.api.ts wrappers."
          }
        ],
        "message": "Renderer preload access must stay behind *.api.ts wrappers."
      },
      {
        "id": "renderer-fsd-public-api-imports",
        "type": "forbidden-import",
        "severity": "error",
        "files": "apps/*/src/**/*.{ts,tsx}",
        "restrictions": [
          {
            "source": "^@/(entities|features|widgets)/[^/]+/.+",
            "allowedIn": [],
            "message": "Alias imports into FSD slices must stop at the slice public API index.ts."
          },
          {
            "source": "^(\\.\\./)+(entities|features|widgets)/[^/]+/.+",
            "allowedIn": [],
            "message": "Relative imports into another FSD slice must stop at the slice public API index.ts. An app with no @/ alias of its own (Backpack Studio) reaches its slices this way, and the law is the same one."
          }
        ],
        "includeTypeImports": true
      },
      {
        "id": "renderer-no-default-exports",
        "type": "regex",
        "severity": "error",
        "files": "apps/*/src/**/*.{ts,tsx}",
        "exclude": ["apps/*/src/**/*.stories.tsx"],
        "pattern": "^\\s*export\\s+default\\b",
        "message": "Use named exports only in renderer code. Story files are left out: a story's meta is the one default export Storybook needs."
      },
      {
        "id": "retire-src-components-dir",
        "type": "retired-path",
        "severity": "error",
        "paths": [
          {
            "pattern": "apps/*/src/components/**/*",
            "reason": "Use FSD-lite layers and shared design-system ownership",
            "migratedTo": "the app's src/shared/ui/ or an FSD slice"
          }
        ]
      },
      {
        "id": "retire-src-hooks-dir",
        "type": "retired-path",
        "severity": "error",
        "paths": [
          {
            "pattern": "apps/*/src/hooks/**/*",
            "reason": "Use FSD-lite layers for hooks",
            "migratedTo": "the app's src/shared/hooks/ or an FSD slice hook"
          }
        ]
      },
      {
        "id": "retire-src-lib-dir",
        "type": "retired-path",
        "severity": "error",
        "paths": [
          {
            "pattern": "apps/*/src/lib/**/*",
            "reason": "Use shared lib folder",
            "migratedTo": "the app's src/shared/lib/"
          }
        ]
      },
      {
        "id": "renderer-fsd-lite-boundaries",
        "type": "import-boundary",
        "severity": "error",
        "layers": {
          "shared": {
            "files": "apps/*/src/shared/**/*.{ts,tsx}",
            "allowImportsFrom": []
          },
          "entities": {
            "files": "apps/*/src/entities/**/*.{ts,tsx}",
            "allowImportsFrom": ["shared", "entities"]
          },
          "features": {
            "files": "apps/*/src/features/**/*.{ts,tsx}",
            "allowImportsFrom": ["shared", "entities"]
          },
          "widgets": {
            "files": "apps/*/src/widgets/**/*.{ts,tsx}",
            "allowImportsFrom": ["shared", "entities", "features"]
          },
          "app": {
            "files": "apps/*/src/app/**/*.{ts,tsx}",
            "allowImportsFrom": ["shared", "entities", "features", "widgets"]
          }
        }
      },
      {
        "id": "presentational-no-effects",
        "type": "regex",
        "severity": "error",
        "files": "apps/*/src/**/*.presentational.tsx",
        "pattern": "\\buse(Effect|LayoutEffect|InsertionEffect)\\b",
        "mustMatch": false,
        "message": "Presentational components must not use useEffect/useLayoutEffect/useInsertionEffect. Move effects to *.container.tsx."
      },
      {
        "id": "presentational-no-electron",
        "type": "regex",
        "severity": "error",
        "files": "apps/*/src/**/*.presentational.tsx",
        "pattern": "from\\s+['\"]electron['\"]",
        "mustMatch": false,
        "message": "Presentational components must not import electron."
      },
      {
        "id": "renderer-no-direct-electron",
        "type": "regex",
        "severity": "error",
        "files": "apps/*/src/**/*.{ts,tsx}",
        "pattern": "from\\s+['\"]electron['\"]",
        "mustMatch": false,
        "message": "Renderer code must not import electron directly. Use preload-exposed APIs via *.api.ts wrappers. Vite bundles such an import into the browser chunk with only a warning, so nothing but this rule stands between it and a runtime failure on a user's machine."
      },
      {
        "id": "pure-files-need-sibling-tests",
        "type": "file-pairing",
        "severity": "error",
        "files": "apps/*/src/**/*.pure.ts",
        "pair": {
          "from": "\\.pure\\.ts$",
          "to": ".pure.test.ts"
        },
        "mustExist": true,
        "message": "Every *.pure.ts has a sibling *.pure.test.ts."
      },
      {
        "id": "pure-functions-tested",
        "type": "symbol-reference",
        "severity": "error",
        "sourceFiles": "apps/*/src/**/*.pure.ts",
        "targetFiles": "apps/*/src/**/*.pure.test.ts",
        "targetPair": {
          "from": "\\.pure\\.ts$",
          "to": ".pure.test.ts"
        },
        "symbolKinds": ["function-declaration", "function-variable"],
        "message": "Exported pure functions must be referenced in sibling unit tests"
      },
      {
        "id": "no-raw-button-outside-shared",
        "type": "regex",
        "severity": "warning",
        "files": "apps/convergence/src/{app,widgets,features,entities}/**/*.container.tsx",
        "pattern": "<button[\\s>]",
        "message": "Use Button from @convergence/ui instead of raw <button> in a container. Presentational parts have raw-elements-need-a-reason (design-system-drift.json), which takes a reason; a container takes none. Scoped to apps/convergence deliberately: it names Convergence's own design system, and Backpack Studio's is Backpack (MAR-2705)."
      },
      {
        "id": "no-raw-input-outside-shared",
        "type": "regex",
        "severity": "warning",
        "files": "apps/convergence/src/{app,widgets,features,entities}/**/*.container.tsx",
        "pattern": "<input[\\s>]",
        "message": "Use Input from @convergence/ui instead of raw <input> in a container. Presentational parts have raw-elements-need-a-reason (design-system-drift.json), which takes a reason; a container takes none. Scoped to apps/convergence deliberately: it names Convergence's own design system, and Backpack Studio's is Backpack (MAR-2705)."
      }
    ]
  }
}
