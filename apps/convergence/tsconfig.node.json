{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "electron/**/*",
    "src/shared/lib/keyboard-shortcut.pure.ts",
    "src/shared/lib/execution-host-id.pure.ts",
    "src/shared/lib/execution-host-id.fixture.ts",
    "electron.vite.config.ts",
    "../../eslint.config.test.ts",
    "vitest.config.ts",
    "vitest.pure.config.ts",
    "vitest.unit.config.ts"
  ],
  "exclude": ["node_modules"]
}
