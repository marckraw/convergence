{
  "name": "backpack-studio",
  "version": "0.1.0",
  "private": true,
  "description": "The second body: a remote-only creation app for the EF disciplines, named after the design system its users already live in",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:mac:unsigned": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --x64 --arm64 --publish never && node tools/verify-release-assets.mjs",
    "test": "vitest run --config vitest.pure.config.ts",
    "test:pure": "vitest run --config vitest.pure.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:design": "node tools/verify-design-system.mjs",
    "package:mac": "npm run build && electron-builder --mac dmg zip --x64 --arm64 --publish never && node tools/verify-release-assets.mjs",
    "release:notes": "node ../../tools/extract-release-notes.mjs CHANGELOG.md"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "@convergence/execution-host-client": "*",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "41.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "vite": "^7.3.2",
    "vitest": "^4.1.4",
    "playwright": "^1.60.0",
    "yaml": "^2.8.2",
    "@ef-global/backpack": "4.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "@mrck-labs/execution-host-protocol": "^0.14.0"
  }
}
